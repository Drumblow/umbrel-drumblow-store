#!/usr/bin/env bash
# Roda antes do primeiro `compose up`.
# O umbreld só exporta APP_DATA_DIR depois deste gancho: o caminho vem da posição do script.
#
# Prepara as pastas com o dono do processo dos containers (1000:1000). O CÓDIGO não é baixado
# aqui (o projeto não é público): depois de instalar, os projetos são copiados para
# src/ por SSH — veja deploy/README.md no repositório de quem opera.
set -euo pipefail

APP_DATA_DIR="$(cd "$(dirname "$0")/.." && pwd)"

mkdir -p \
  "$APP_DATA_DIR/src" \
  "$APP_DATA_DIR/src/kotn-tracker/data" \
  "$APP_DATA_DIR/src/kotn-tracker/logs" \
  "$APP_DATA_DIR/src/encore-tracker/data" \
  "$APP_DATA_DIR/src/encore-tracker/logs" \
  "$APP_DATA_DIR/src/product-values/data" \
  "$APP_DATA_DIR/src/product-values/logs" \
  "$APP_DATA_DIR/src/auction-dashboard/logs" \
  "$APP_DATA_DIR/src/auction-dashboard/data" \
  "$APP_DATA_DIR/src/auction-dashboard/backups" \
  "$APP_DATA_DIR/src/lmax-tracker/data" \
  "$APP_DATA_DIR/src/lmax-tracker/logs" \
  "$APP_DATA_DIR/src/mongers-tracker/data" \
  "$APP_DATA_DIR/src/mongers-tracker/logs" \
  "$APP_DATA_DIR/src/mckenzies-tracker/data" \
  "$APP_DATA_DIR/src/mckenzies-tracker/logs" \
  "$APP_DATA_DIR/src/auth-service/data" \
  "$APP_DATA_DIR/src/auth-service/logs"

chown -R 1000:1000 "$APP_DATA_DIR/src" 2>/dev/null || true
chmod 700 "$APP_DATA_DIR/src" 2>/dev/null || true

# ── Senha do porteiro (acesso externo) ─────────────────────────────────────
# Fica FORA do repositório público. O painel continua aberto na LAN e na interface do
# umbrelOS; esta senha vale só para o caminho público (Tailscale Funnel → função na Vercel).
if [ ! -f "$APP_DATA_DIR/auth.env" ]; then
  SENHA="$( (openssl rand -base64 24 2>/dev/null || head -c 24 /dev/urandom | base64) | tr -d '/+=' | cut -c1-28 )"
  printf 'PAINEL_USUARIO=umbrel\nPAINEL_SENHA=%s\n' "$SENHA" > "$APP_DATA_DIR/auth.env"
  chmod 600 "$APP_DATA_DIR/auth.env" 2>/dev/null || true
  chown 1000:1000 "$APP_DATA_DIR/auth.env" 2>/dev/null || true
  echo "[drumblow-leiloes] senha do porteiro criada em $APP_DATA_DIR/auth.env"
  echo "[drumblow-leiloes] veja com: cat \"$APP_DATA_DIR/auth.env\""
else
  echo "[drumblow-leiloes] $APP_DATA_DIR/auth.env já existe — mantido"
fi

# ── Tailscale (acesso externo sem abrir portas) ────────────────────────────
# O serviço tailscale precisa de tailscale.env (auth key com tag:leiloes) e do ts-serve.json.
# Criamos MODELOS para o compose não travar na primeira instalação; a chave em si é sua.
if [ ! -f "$APP_DATA_DIR/tailscale.env" ]; then
  printf '# preencha com a auth key do Tailscale (tag:leiloes) para o Funil externo\n# TS_AUTHKEY=tskey-auth-...\nTS_AUTHKEY=\n' > "$APP_DATA_DIR/tailscale.env"
  chmod 600 "$APP_DATA_DIR/tailscale.env" 2>/dev/null || true
  chown 1000:1000 "$APP_DATA_DIR/tailscale.env" 2>/dev/null || true
  echo "[drumblow-leiloes] modelo de tailscale.env criado (preencha o TS_AUTHKEY)"
fi
if [ ! -f "$APP_DATA_DIR/ts-serve.json" ]; then
  printf '{"TCP":{"443":{"HTTPS":true}},"Web":{"${TS_CERT_DOMAIN}:443":{"Handlers":{"/":{"Proxy":"http://auth-proxy:8788"}}},"AllowFunnel":{"${TS_CERT_DOMAIN}:443":true}}\n' > "$APP_DATA_DIR/ts-serve.json"
  chown 1000:1000 "$APP_DATA_DIR/ts-serve.json" 2>/dev/null || true
  echo "[drumblow-leiloes] ts-serve.json criado"
fi

# ── Contas: envio de e-mail (Gmail SMTP com senha de app) ──────────────────
if [ ! -f "$APP_DATA_DIR/smtp.env" ]; then
  printf '# Serviço de contas — envio de código por e-mail (Gmail SMTP).\n# 1) ative a Verificação em 2 etapas na conta Google\n# 2) crie uma Senha de app em myaccount.google.com/apppasswords\n# 3) cole a senha (16 caracteres, sem espaços) em SMTP_PASS e reinicie o serviço "auth"\nSMTP_HOST=smtp.gmail.com\nSMTP_PORT=465\nSMTP_USER=jhujhones.bkp@gmail.com\nSMTP_PASS=\nMAIL_FROM=Painel Leiloes <jhujhones.bkp@gmail.com>\nAUTH_PEPPER=troque-por-um-valor-aleatorio\n' > "$APP_DATA_DIR/smtp.env"
  chmod 600 "$APP_DATA_DIR/smtp.env" 2>/dev/null || true
  chown 1000:1000 "$APP_DATA_DIR/smtp.env" 2>/dev/null || true
  echo "[drumblow-leiloes] modelo de smtp.env criado (preencha o SMTP_PASS com a senha de app do Gmail)"
fi

echo "[drumblow-leiloes] pastas preparadas em $APP_DATA_DIR/src (copie os projetos para lá)"
